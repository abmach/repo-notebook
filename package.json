{
  "name": "repo-notebook",
  "version": "0.1.0",
  "description": "Agent Skills and a consent-aware installer for durable project context, decisions, principles, and collaborative scoping.",
  "type": "module",
  "bin": {
    "repo-notebook": "./bin/repo-notebook.js"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "agent-skills",
    "ai",
    "change-brief",
    "decisions",
    "glossary",
    "notebook",
    "principles",
    "project-context"
  ],
  "scripts": {
    "validate": "npm run validate:skills && npm run validate:package && npm test",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/abmach/repo-notebook.git"
  },
  "bugs": {
    "url": "https://gitlab.com/abmach/repo-notebook/-/issues"
