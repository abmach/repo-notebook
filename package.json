{
  "name": "repo-notebook",
  "version": "0.4.0",
  "description": "Agent Skills and a consent-aware installer for durable project context, decisions, principles, and collaborative scoping.",
  "type": "module",
  "bin": {
    "repo-notebook": "./bin/repo-notebook.js"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "agent-skills",
    "ai",
    "change-brief",
    "decisions",
    "glossary",
    "notebook",
    "principles",
    "project-context"
  ],
  "scripts": {
    "validate": "bun run validate:skills && bun run validate:package && bun run test",
    "validate:skills": "bun scripts/validate-skills.mjs",
    "validate:package": "bun scripts/validate-package.mjs",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/abmach/repo-notebook.git"
  },
  "bugs": {
    "url": "https://gitlab.com/abmach/repo-notebook/-/issues"
  },
  "author": "Arthur Biazon Machado",
  "license": "MIT",
  "homepage": "https://gitlab.com/abmach/repo-notebook#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.7.5"
  }
}
